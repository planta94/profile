{
  "name": "personal-website",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "build:github-pages": "ng build --base-href /profile/",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "lint": "echo Running ESLint security and quality checks... && eslint \"src/**/*.{ts,html}\" && echo ESLint passed! && echo Running Prettier style checks... && prettier --check \"src/**/*.{ts,html,scss}\" \"public/**/*.json\"",
    "format": "prettier --write \"src/**/*.{ts,html,scss}\" \"public/**/*.json\"",
    "e2e": "playwright test",
    "e2e:report": "playwright show-report",
    "qa:scan": "veriscribe scan",
    "qa:impact": "veriscribe impact",
    "qa:manual": "veriscribe manual",
    "qa:gate": "veriscribe gate",
    "qa:openapi-slice": "veriscribe openapi-slice",
    "qa:scaffold": "veriscribe scaffold",
    "qa:serve": "veriscribe serve",
    "qa:doctor": "veriscribe doctor"
  },
  "private": true,
  "type": "module",
  "packageManager": "npm@12.2.1",
  "dependencies": {
    "@angular/common": "^22.2.3",
    "@angular/compiler": "^22.2.3",
    "@angular/core": "^22.2.3",
    "@angular/forms": "^22.2.3",
    "@angular/platform-browser": "^22.2.3",
    "@angular/router": "^22.2.3",
    "html2canvas": "^1.4.1",
    "jspdf": "^4.2.1",
    "rxjs": "~7.8.2",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@angular-eslint/eslint-plugin-template": "^22.6.0",
    "@angular-eslint/template-parser": "^22.6.0",
    "@angular/build": "^22.2.4",
    "@angular/cli": "^22.2.4",
    "@angular/compiler-cli": "^22.2.3",
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@typescript-eslint/eslint-plugin": "^8.72.0",
    "@typescript-eslint/parser": "^8.72.0",
    "@vitest/coverage-v8": "^5.0.5",
    "angular-eslint": "^22.6.0",
    "eslint": "^10.13.0",
    "eslint-plugin-security": "^4.2.0",
    "globals": "^17.13.0",
    "jsdom": "^30.1.3",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "veriscribe": "^1.5.0",
    "vitest": "^5.0.5"
  },
  "overrides": {
    "vite": "^8.3.2"
  }
}
